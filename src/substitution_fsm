library IEEE;
use IEEE.STD_LOGIC_1164.ALL;
use IEEE.NUMERIC_STD.ALL;

entity substitution_fsm is
    Port (
        clk           : in  std_logic;
        reset         : in  std_logic;

        game_active   : in  std_logic;
         on_court      : in  std_logic;
        hot_player    : in  std_logic;
        suggest_rest  : in  std_logic;
        must_sub      : in  std_logic;

        state_keep    : out std_logic;
        state_suggest : out std_logic;
        state_must    : out std_logic
    );
end substitution_fsm;

architecture Behavioral of substitution_fsm is

    ------------------------------------------------------------------
    -- States
    ------------------------------------------------------------------
    type state_t is (
        IDLE,       
        GRACE,       
        ST_KEEP,     
        ST_SUGGEST,  
        ST_MUST_SUB  
    );

    signal state, next_state : state_t;

    
    signal grace_cnt : unsigned(3 downto 0) := (others => '0');

begin

    ------------------------------------------------------------------
    -- State register + grace counter
    ------------------------------------------------------------------
    process(clk)
    begin
        if rising_edge(clk) then
            if reset = '1' then
                state     <= IDLE;
                grace_cnt <= (others => '0');

            else
                state <= next_state;

                if state = GRACE then
                    if grace_cnt < 10 then
                        grace_cnt <= grace_cnt + 1;
                    end if;
                else
                    grace_cnt <= (others => '0');
                end if;
            end if;
        end if;
    end process;

    ------------------------------------------------------------------
    -- Next state logic
    ------------------------------------------------------------------
    process(state, game_active, grace_cnt, hot_player, suggest_rest, must_sub)
    begin
        next_state <= state;

        case state is

            when IDLE =>
                if game_active = '1' then
                    next_state <= GRACE;
                end if;

            when GRACE =>
                if game_active = '0' then
                    next_state <= IDLE;
                elsif grace_cnt = 10 then
                    next_state <= ST_KEEP;
                end if;

            when ST_KEEP =>
                if game_active = '0' then
                    next_state <= IDLE;
                elsif must_sub = '1' then
                    next_state <= ST_MUST_SUB;
                elsif suggest_rest = '1' then
                    next_state <= ST_SUGGEST;
                end if;

            when ST_SUGGEST =>
                if game_active = '0' then
                    next_state <= IDLE;
                elsif must_sub = '1' then
                    next_state <= ST_MUST_SUB;
                elsif hot_player = '1' then
                    next_state <= ST_KEEP;
                end if;

            when ST_MUST_SUB =>
    if game_active = '0' then
        next_state <= IDLE;

    elsif on_court = '0' then
        
        next_state <= GRACE;

    else
        next_state <= ST_MUST_SUB;
    end if;


        end case;
    end process;

    ------------------------------------------------------------------
    -- Output decode
    ------------------------------------------------------------------
    state_keep    <= '1' when state = ST_KEEP     else '0';
    state_suggest <= '1' when state = ST_SUGGEST  else '0';
    state_must    <= '1' when state = ST_MUST_SUB else '0';

end Behavioral;
